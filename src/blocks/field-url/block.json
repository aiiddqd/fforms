{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fforms/field-url",
	"title": "URL field",
	"category": "widgets",
	"icon": "admin-links",
	"description": "Collect and validate a web address.",
	"keywords": [ "url", "link", "website" ],
	"textdomain": "fforms",
	"ancestor": [ "fforms/form" ],
	"attributes": {
		"fieldId": { "type": "string", "role": "content" },
		"name": { "type": "string", "role": "content" },
		"label": { "type": "string", "role": "content" },
		"required": { "type": "boolean", "role": "content", "default": false },
		"placeholder": { "type": "string", "role": "content" },
		"maxLength": { "type": "number", "role": "content", "default": 0 },
		"options": { "type": "array", "role": "content", "default": [] }
	},
	"supports": {
		"html": false,
		"visibility": false,
		"color": { "text": true, "background": false, "gradients": false },
		"spacing": { "margin": [ "top", "bottom" ], "padding": true },
		"typography": { "fontSize": true, "lineHeight": true }
	},
	"selectors": { "root": ".wp-block-fforms-field-url" },
	"example": {
		"attributes": {
			"fieldId": "website",
			"name": "website",
			"label": "Website",
			"placeholder": "https://example.com"
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
