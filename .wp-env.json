{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.3",
	"plugins": [ "." ],
	"port": 8890,
	"testsEnvironment": false,
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": "local"
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp rewrite structure '/%postname%/' --hard"
	}
}
