{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fforms/field-tel",
  "title": "Phone field",
  "category": "widgets",
  "icon": "phone",
  "description": "Collect a telephone number.",
  "keywords": [
    "phone",
    "telephone",
    "tel"
  ],
  "textdomain": "fforms",
  "ancestor": [
    "fforms/form",
    "fforms/headless-schema"
  ],
  "attributes": {
    "fieldId": {
      "type": "string",
      "role": "content"
    },
    "name": {
      "type": "string",
      "role": "content"
    },
    "label": {
      "type": "string",
      "role": "content"
    },
    "required": {
      "type": "boolean",
      "role": "content",
      "default": false
    },
    "placeholder": {
      "type": "string",
      "role": "content"
    },
    "maxLength": {
      "type": "number",
      "role": "content",
      "default": 0
    },
    "options": {
      "type": "array",
      "role": "content",
      "default": []
    }
  },
  "supports": {
    "html": false,
    "visibility": false,
    "color": {
      "text": true,
      "background": false,
      "gradients": false
    },
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ],
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "selectors": {
    "root": ".wp-block-fforms-field-tel"
  },
  "example": {
    "attributes": {
      "fieldId": "phone",
      "name": "phone",
      "label": "Phone",
      "placeholder": "+1 234 567 890",
      "required": true
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}